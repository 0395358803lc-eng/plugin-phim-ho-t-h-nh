{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/video-hoat-hinh/film-data/v1.schema.json",
  "title": "Video-hoat-hinh FilmData v1 (source agreement)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "filmId", "masterEngine", "fps", "width", "height", "durationInFrames", "shots", "dialogues"],
  "properties": {
    "schemaVersion": {"const": 1},
    "filmId": {"type": "string", "minLength": 1},
    "masterEngine": {"enum": ["openfilm", "remotion"]},
    "fps": {"type": "integer", "minimum": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "durationInFrames": {"type": "integer", "minimum": 1},
    "shots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shot"}},
    "dialogues": {"type": "array", "items": {"$ref": "#/$defs/dialogue"}}
  },
  "$defs": {
    "shot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "startFrame", "durationInFrames", "type", "scene"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "startFrame": {"type": "integer", "minimum": 0},
        "durationInFrames": {"type": "integer", "minimum": 1},
        "type": {"enum": ["2d", "3d"]},
        "scene": {"type": "string", "minLength": 1}
      }
    },
    "dialogue": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "shotId", "speaker", "text", "startFrame", "endFrame", "audio"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "shotId": {"type": "string", "minLength": 1},
        "speaker": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "startFrame": {"type": "integer", "minimum": 0},
        "endFrame": {"type": "integer", "minimum": 1},
        "audio": {"type": "string", "minLength": 1}
      }
    }
  }
}
