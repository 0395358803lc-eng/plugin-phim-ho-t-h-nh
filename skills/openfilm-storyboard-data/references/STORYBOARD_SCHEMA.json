{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data-only storyboard v1.14.2",
  "type": "object",
  "required": ["schemaVersion", "filmId", "masterEngine", "fps", "shots"],
  "properties": {
    "schemaVersion": {"const": 1},
    "filmId": {"type": "string", "minLength": 1},
    "masterEngine": {"enum": ["openfilm", "remotion"]},
    "fps": {"type": "integer", "minimum": 1},
    "shots": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["shotId", "sceneId", "startFrame", "durationInFrames", "layout", "characters", "action", "camera", "background", "lighting", "motion", "audioIds", "subtitleIds", "transition", "implementation", "assetRefs"], "properties": {
      "shotId": {"type": "string", "minLength": 1},
      "sceneId": {"type": "string", "minLength": 1},
      "startFrame": {"type": "integer", "minimum": 0},
      "durationInFrames": {"type": "integer", "minimum": 1},
      "layout": {"type": "object"},
      "characters": {"type": "array"},
      "action": {"type": "array"},
      "camera": {"type": "object"},
      "background": {"type": "object"},
      "lighting": {"type": "object"},
      "motion": {"type": "array"},
      "audioIds": {"type": "array", "items": {"type": "string"}},
      "subtitleIds": {"type": "array", "items": {"type": "string"}},
      "transition": {"type": "object"},
      "implementation": {"enum": ["svg", "html", "canvas", "threejs", "tsx", "r3f"]},
      "assetRefs": {"type": "array", "items": {"type": "string"}},
      "notes": {"type": "string"}
    }}}
  },
  "additionalProperties": true
}
